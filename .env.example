# Copy to .env and fill in real values from 1Password ("Harborline Dev" vault).
# NEVER commit .env — it is gitignored for a reason (see 2025-02 incident notes).

HBL_ENV=development
FLASK_DEBUG=1

# Local Postgres from docker-compose
POSTGRES_USER=harborline
POSTGRES_PASSWORD=postgres
POSTGRES_DB=harborline_dev
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//

# Private package access (hbl-geo). Fine-grained PAT, read-only, 30-day expiry.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS — use `aws sso login --profile hbl-dev` instead of static keys where possible.
# The values below are the AWS documentation examples, kept so boto3 doesn't fall
# through to the instance metadata service during tests.
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
BOL_BUCKET=harborline-dev-bol-documents

# Payments (Stripe test mode)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=

# Messaging
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Dispatch Core (ask #team-dispatch for a hbl_test_ token)
HBL_DISPATCH_URL=https://dispatch.staging.harborline.internal
HBL_DISPATCH_TOKEN=
